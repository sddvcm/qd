#!/bin/bash
# QDX 安装前检查 - 在应用文件落地前执行
#
# 此处只做环境检查，不做任何需要应用文件的操作。
# 安装失败时必须把原因写入 TRIM_TEMP_LOGFILE，用户才能看到。

set -u

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$*" > "${TRIM_TEMP_LOGFILE}"
    fi
    echo "$*" >&2
    exit 1
}

# 存储空间检查
# 注意: 不要对 TRIM_APPDEST_VOL 的卷根目录(如 /vol1)做写入测试。
# 卷根目录由系统管理, 安装进程没有写权限也不需要写权限;
# 对它 touch 必然失败, 会把所有安装都误判为"存储空间不可写"。
# 真正需要写的是 fnOS 预建好的应用数据目录 TRIM_PKGVAR。
if [ -n "${TRIM_PKGVAR:-}" ] && [ -d "${TRIM_PKGVAR}" ]; then
    if ! touch "${TRIM_PKGVAR}/.qdx_write_test" 2>/dev/null; then
        fail "应用数据目录不可写: ${TRIM_PKGVAR}，请检查存储空间状态。"
    fi
    rm -f "${TRIM_PKGVAR}/.qdx_write_test" 2>/dev/null
fi
# TRIM_PKGVAR 不存在时不在此报错 —— 目录由 fnOS 在安装流程中创建,
# 缺失导致的失败会在 install_callback 中以更明确的上下文暴露。

# 检查 Python 3 是否可用（fnOS 自带）
PYTHON_BIN=""
for candidate in python3 python3.11 python3.10 python3.9 python3.12; do
    if command -v "${candidate}" >/dev/null 2>&1; then
        if "${candidate}" -c "import sys; sys.exit(0 if sys.version_info >= (3,8) else 1)" 2>/dev/null; then
            PYTHON_BIN="${candidate}"
            break
        fi
    fi
done

if [ -z "${PYTHON_BIN}" ]; then
    fail "未找到 Python 3.8 或更高版本。QDX 需要系统 Python 环境，请确认 fnOS 版本不低于 0.9.0。"
fi

exit 0
