#!/bin/bash
# QDX 升级后处理 - 在应用文件替换完成后执行
#
# 保持轻量（与 relay-monitor 相同架构）：
#   1. 备份数据库
#   2. 清除 wheels/模板初始化标记 —— 下次启动时 cmd/main 的 ensure_runtime
#      会自动重新离线安装依赖（pip 全部已满足时秒级完成）并增量同步模板
#   3. 重启服务
#
# 数据库始终在 TRIM_PKGVAR，不参与替换，因此数据不会丢失。

set -u

APP_DIR="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
RT="${DATA_DIR}/runtime"
LOG_FILE="${DATA_DIR}/upgrade.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}" 2>/dev/null
}

log "--- 升级后处理: ${TRIM_APPVER:-?} ---"

# 1. 备份数据库
DB_FILE="${DATA_DIR}/database.db"
if [ -f "$DB_FILE" ]; then
    BACKUP_DIR="${DATA_DIR}/backup/upgrade-$(date +%Y%m%d%H%M%S)"
    mkdir -p "$BACKUP_DIR" 2>/dev/null
    if cp -f "$DB_FILE" "$BACKUP_DIR/database.db" 2>/dev/null; then
        log "数据库已备份到 $BACKUP_DIR/database.db"
    else
        log "警告: 数据库备份失败，但升级继续"
    fi
    # 只保留最近 5 份备份
    ls -1dt "${DATA_DIR}/backup"/upgrade-* 2>/dev/null | tail -n +6 | while read -r old; do
        rm -rf "$old" 2>/dev/null
    done
fi

# 2. 清除初始化标记，让 ensure_runtime 重新执行（依赖已满足时很快）
rm -f "${RT}/.wheels_installed" "${RT}/.templates_imported" 2>/dev/null
log "已重置初始化标记，依赖与模板将在下次启动时自动更新"

# 3. 重启服务
log "重启服务"
if [ -x "${APP_DIR}/cmd/main" ]; then
    "${APP_DIR}/cmd/main" start >> "${LOG_FILE}" 2>&1
    if [ $? -eq 0 ]; then
        log "服务已重启"
    else
        log "警告: 服务重启失败，请手动启动后查看日志"
    fi
else
    log "警告: 未找到 cmd/main，跳过自动启动"
fi

log "=== 升级完成 ==="
exit 0
