#!/bin/bash
# QDX 安装后处理 - 在应用文件落地后执行
#
# 职责:
#   1. 创建 Python 虚拟环境（离线，不访问网络）
#   2. 从包内内置的 wheels 目录安装全部依赖（离线）
#   3. 生成持久化配置，把数据库与数据目录指向 TRIM_PKGVAR
#   4. 导入内置模板快照到数据库
#
# 全部操作离线完成，不下载任何东西。

set -u

APP_DIR="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
ETC_DIR="${TRIM_PKGETC}"
WHEELS_DIR="${APP_DIR}/wheels"
TEMPLATES_DIR="${APP_DIR}/templates"
VENV_DIR="${DATA_DIR}/venv"
LOG_FILE="${DATA_DIR}/install.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}" 2>/dev/null
}

fail() {
    local msg="$1"
    log "ERROR: ${msg}"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

mkdir -p "${DATA_DIR}" "${ETC_DIR}" 2>/dev/null
: > "${LOG_FILE}" 2>/dev/null

log "=== QDX 安装开始 ==="
log "应用目录: ${APP_DIR}"
log "数据目录: ${DATA_DIR}"

# ---------------------------------------------------------------
# 1. 定位系统 Python
# ---------------------------------------------------------------
PYTHON_BIN=""
for candidate in python3 python3.11 python3.10 python3.9 python3.12; do
    if command -v "${candidate}" >/dev/null 2>&1; then
        if "${candidate}" -c "import sys; sys.exit(0 if sys.version_info >= (3,8) else 1)" 2>/dev/null; then
            PYTHON_BIN="$(command -v "${candidate}")"
            break
        fi
    fi
done

if [ -z "${PYTHON_BIN}" ]; then
    fail "未找到可用的 Python 3.8+ 环境，安装终止。"
fi

PYVER=$("${PYTHON_BIN}" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
log "使用 Python: ${PYTHON_BIN} (${PYVER})"

# ---------------------------------------------------------------
# 2. 创建虚拟环境
# ---------------------------------------------------------------
if [ -d "${VENV_DIR}" ]; then
    log "虚拟环境已存在，跳过创建"
else
    log "创建虚拟环境: ${VENV_DIR}"
    if ! "${PYTHON_BIN}" -m venv "${VENV_DIR}" 2>>"${LOG_FILE}"; then
        # fnOS 精简环境可能缺 ensurepip，退化用 virtualenv 或直接装到用户目录
        log "venv 创建失败，尝试备用方案"
        if ! "${PYTHON_BIN}" -m venv --without-pip "${VENV_DIR}" 2>>"${LOG_FILE}"; then
            fail "无法创建 Python 虚拟环境。请确认系统已安装 python3-venv。"
        fi
    fi
fi

VENV_PY="${VENV_DIR}/bin/python"

if [ ! -x "${VENV_PY}" ]; then
    fail "虚拟环境创建后未找到 ${VENV_PY}"
fi

# ---------------------------------------------------------------
# 3. 离线安装依赖
# ---------------------------------------------------------------
if [ ! -d "${WHEELS_DIR}" ]; then
    fail "内置依赖目录缺失: ${WHEELS_DIR}，安装包可能不完整。"
fi

WHEEL_COUNT=$(ls -1 "${WHEELS_DIR}"/*.whl 2>/dev/null | wc -l)
if [ "${WHEEL_COUNT}" -eq 0 ]; then
    fail "内置依赖目录为空: ${WHEELS_DIR}"
fi

log "发现 ${WHEEL_COUNT} 个内置依赖包，开始离线安装"

# 确保 pip 可用（venv 可能没装 pip）
if ! "${VENV_PY}" -m pip --version >/dev/null 2>&1; then
    log "venv 中无 pip，使用系统 pip 引导"
    # 优先用内置的 pip wheel 离线安装 pip
    PIP_WHEEL=$(ls -1 "${WHEELS_DIR}"/pip-*.whl 2>/dev/null | head -n 1)
    if [ -n "${PIP_WHEEL}" ]; then
        "${VENV_PY}" "${PIP_WHEEL}/pip" install --no-index --find-links "${WHEELS_DIR}" pip >> "${LOG_FILE}" 2>&1
    fi
fi

# 核心：--no-index 强制不访问网络，只用本地 wheels
log "执行离线安装 (--no-index)"
if ! "${VENV_PY}" -m pip install \
        --no-index \
        --find-links "${WHEELS_DIR}" \
        --no-cache-dir \
        -r "${APP_DIR}/requirements.txt" >> "${LOG_FILE}" 2>&1; then
    log "按 requirements.txt 安装失败，尝试安装目录内全部 wheel"
    if ! "${VENV_PY}" -m pip install \
            --no-index \
            --find-links "${WHEELS_DIR}" \
            --no-cache-dir \
            "${WHEELS_DIR}"/*.whl >> "${LOG_FILE}" 2>&1; then
        fail "依赖离线安装失败，详见日志: ${LOG_FILE}"
    fi
fi

log "依赖安装完成"

# 校验核心依赖可导入
if ! "${VENV_PY}" -c "import tornado, sqlalchemy, aiohttp, aiosqlite" >> "${LOG_FILE}" 2>&1; then
    fail "核心依赖导入失败（tornado/sqlalchemy/aiohttp/aiosqlite），详见日志: ${LOG_FILE}"
fi
log "核心依赖校验通过"

# ---------------------------------------------------------------
# 4. 生成持久化配置
# ---------------------------------------------------------------
# fnOS 的 target 目录在升级时会被替换，因此配置与数据库必须放在
# TRIM_PKGVAR 指向的持久化目录。QD 官方支持 local_config.py 覆盖机制。

LOCAL_CONFIG="${APP_DIR}/local_config.py"

cat > "${LOCAL_CONFIG}" << PYEOF
# -*- coding: utf-8 -*-
# QDX 由 fnOS 生命周期脚本自动生成，请勿手动修改。
# 此文件位于应用源码目录之外不会丢失——升级时由 upgrade_callback 重新生成。

import os

# 数据库持久化到 TRIM_PKGVAR，避免升级时数据丢失
_QDX_DATA = os.environ.get("QDX_DATA_DIR", "${DATA_DIR}")


class sqlite3:
    path = os.path.join(_QDX_DATA, "database.db")


# 是否启用 Redis（fnOS 上默认不启用，Worker 自动降级为本地队列）
redis_url = os.environ.get("REDIS_URL", "redis://localhost:6379")
PYEOF

log "已生成持久化配置: ${LOCAL_CONFIG}"

# 环境变量文件，供 cmd/main 加载
cat > "${ETC_DIR}/env.sh" << ENVEOF
# QDX 运行环境变量 - 由 install_callback 生成
QDX_DATA_DIR="${DATA_DIR}"
QDX_ETC_DIR="${ETC_DIR}"
ENVEOF

log "已生成环境变量文件: ${ETC_DIR}/env.sh"

# ---------------------------------------------------------------
# 5. 导入内置模板
# ---------------------------------------------------------------
if [ -f "${TEMPLATES_DIR}/tpls_history.json" ]; then
    log "发现内置模板快照，导入数据库"
    cd "${APP_DIR}" || fail "无法进入应用目录"
    if QDX_DATA_DIR="${DATA_DIR}" "${VENV_PY}" "${APP_DIR}/deploy/fnos/scripts/import_templates.py" >> "${LOG_FILE}" 2>&1; then
        log "内置模板导入完成"
    else
        # 模板导入失败不应导致整个安装失败
        log "警告: 内置模板导入失败，可在应用内手动导入。详见日志。"
    fi
else
    log "未发现内置模板快照，跳过导入"
fi

log "=== QDX 安装完成 ==="
exit 0
