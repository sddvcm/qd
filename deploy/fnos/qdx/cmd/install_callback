#!/bin/bash
# QDX 安装后处理 - 在应用文件落地后执行
#
# 刻意保持极轻量：不做解压 Python、装依赖、导模板等重型操作。
# 全部初始化逻辑在 cmd/main 的 ensure_runtime 首次启动时完成，
# 即使初始化失败也不影响安装结果，且日志可查（与 relay-monitor 相同架构）。

set -u

APP_DIR="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${DATA_DIR}/install.log" 2>/dev/null
}

mkdir -p "${DATA_DIR}/runtime" 2>/dev/null

log "QDX ${TRIM_APPVER:-?} 安装完成，依赖初始化将在首次启动时进行"

exit 0
