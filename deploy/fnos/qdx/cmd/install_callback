#!/bin/bash
# QDX 安装后处理 - 在应用文件落地后执行
#
# 职责:
#   1. 创建 Python 虚拟环境（离线，不访问网络）
#   2. 从包内内置的 wheels 目录安装全部依赖（离线）
#   3. 生成持久化配置，把数据库与数据目录指向 TRIM_PKGVAR
#   4. 导入内置模板快照到数据库
#
# 全部操作离线完成，不下载任何东西。

set -u

APP_DIR="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
ETC_DIR="${TRIM_PKGETC}"
WHEELS_DIR="${APP_DIR}/wheels"
TEMPLATES_DIR="${APP_DIR}/templates"
VENV_DIR="${DATA_DIR}/venv"
LOG_FILE="${DATA_DIR}/install.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}" 2>/dev/null
}

fail() {
    local msg="$1"
    log "ERROR: ${msg}"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

mkdir -p "${DATA_DIR}" "${ETC_DIR}" 2>/dev/null
: > "${LOG_FILE}" 2>/dev/null

log "=== QDX 安装开始 ==="
log "应用目录: ${APP_DIR}"
log "数据目录: ${DATA_DIR}"

# ---------------------------------------------------------------
# 1. 定位系统 Python
# ---------------------------------------------------------------
PYTHON_BIN=""
for candidate in python3 python3.11 python3.10 python3.9 python3.12; do
    if command -v "${candidate}" >/dev/null 2>&1; then
        if "${candidate}" -c "import sys; sys.exit(0 if sys.version_info >= (3,8) else 1)" 2>/dev/null; then
            PYTHON_BIN="$(command -v "${candidate}")"
            break
        fi
    fi
done

if [ -z "${PYTHON_BIN}" ]; then
    fail "未找到可用的 Python 3.8+ 环境，安装终止。"
fi

PYVER=$("${PYTHON_BIN}" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
log "使用 Python: ${PYTHON_BIN} (${PYVER})"

# 校验内置 wheel 是否与本机 Python 版本匹配。
# wheel 是按特定 ABI 编译的(cp38/cp39/cp311...), 版本不符时 pip 会
# 全部拒绝安装。提前检测并给出明确原因, 比让 pip 报一堆晦涩错误好排查。
#
# 取 ABI tag: 3.11 -> cp311, 3.12 -> cp312, 3.13 -> cp313
CPY_TAG="cp$(echo "${PYVER}" | tr -d '.')"
log "本机 ABI 标签: ${CPY_TAG}"

# 抽样检查内置的编译型 wheel 是否有匹配版本。
# 纯 Python 包(py3-none-any)任何版本都能用, 只看带具体 ABI 的。
MATCH_COUNT=0
ABI_WHEEL_SAMPLE=""
for w in "${WHEELS_DIR}"/*.whl; do
    [ -f "${w}" ] || continue
    base=$(basename "${w}")
    case "${base}" in
        # 含 cpXXX 且不含 py3-none-any 的, 是版本相关的编译包
        *cp3[0-9][0-9]*)
            if [ -z "${ABI_WHEEL_SAMPLE}" ]; then
                ABI_WHEEL_SAMPLE="${base}"
            fi
            # 该 wheel 的 ABI 是否与当前解释器匹配（含 abi3 向前兼容）
            if echo "${base}" | grep -q "${CPY_TAG}"; then
                MATCH_COUNT=$((MATCH_COUNT + 1))
            elif echo "${base}" | grep -q "cp3[0-9][0-9]-abi3"; then
                # abi3 包（如 cryptography/pycryptodome）对更高版本向下兼容
                WHL_TAG=$(echo "${base}" | grep -o 'cp[0-9][0-9]' | head -1)
                WHL_NUM=$(echo "${WHL_TAG}" | tr -d 'cp')
                PY_NUM=$(echo "${PYVER}" | tr -d '.')
                if [ "${PY_NUM}" -ge "${WHL_NUM}" ] 2>/dev/null; then
                    MATCH_COUNT=$((MATCH_COUNT + 1))
                fi
            fi
            ;;
    esac
done

if [ "${MATCH_COUNT}" -eq 0 ]; then
    log "诊断: 内置 wheel 与本机 Python ${PYVER} 不匹配"
    log "  样例 wheel: ${ABI_WHEEL_SAMPLE}"
    log "  本机 ABI 标签: ${CPY_TAG}"
    fail "内置依赖与本机 Python ${PYVER} 不兼容（需要 ${CPY_TAG} 的 wheel）。请使用与飞牛系统 Python 版本匹配的安装包。"
fi

log "内置 wheel 版本匹配检查通过（${MATCH_COUNT} 个编译包匹配）"

# ---------------------------------------------------------------
# 2. 创建虚拟环境
# ---------------------------------------------------------------
VENV_MODE="venv"
VENV_PY=""

make_venv() {
    # 优先标准 venv
    if "${PYTHON_BIN}" -m venv "${VENV_DIR}" >> "${LOG_FILE}" 2>&1; then
        VENV_PY="${VENV_DIR}/bin/python"
        [ -x "${VENV_PY}" ] && return 0
    fi

    # 退化：不带 pip 创建，稍后用内置 pip wheel 引导
    log "标准 venv 创建失败，尝试 --without-pip"
    if "${PYTHON_BIN}" -m venv --without-pip "${VENV_DIR}" >> "${LOG_FILE}" 2>&1; then
        VENV_PY="${VENV_DIR}/bin/python"
        [ -x "${VENV_PY}" ] && return 0
    fi

    return 1
}

if [ -x "${VENV_DIR}/bin/python" ]; then
    log "虚拟环境已存在，复用"
    VENV_PY="${VENV_DIR}/bin/python"
elif make_venv; then
    log "虚拟环境创建成功: ${VENV_DIR}"
else
    # 最终兜底：不用 venv，直接把依赖装到应用数据目录下的独立 site 目录，
    # 运行时通过 PYTHONPATH 注入。适用于系统缺 python3-venv 的环境。
    log "venv 不可用，改用独立 site-packages 方案"
    VENV_MODE="sitepkg"
    VENV_PY="${PYTHON_BIN}"
    SITE_DIR="${DATA_DIR}/pylibs"
    mkdir -p "${SITE_DIR}" 2>/dev/null
    export PYTHONUSERBASE="${DATA_DIR}/pyuserbase"
    mkdir -p "${PYTHONUSERBASE}" 2>/dev/null
fi

log "Python 执行方式: ${VENV_MODE} -> ${VENV_PY}"

# 供运行时使用的环境变量（sitepkg 模式下需要 PYTHONPATH）
PIP_TARGET_ARGS=""
if [ "${VENV_MODE}" = "sitepkg" ]; then
    PIP_TARGET_ARGS="--target ${SITE_DIR}"
fi

# ---------------------------------------------------------------
# 3. 离线安装依赖
# ---------------------------------------------------------------
if [ ! -d "${WHEELS_DIR}" ]; then
    fail "内置依赖目录缺失: ${WHEELS_DIR}，安装包可能不完整。"
fi

WHEEL_COUNT=$(ls -1 "${WHEELS_DIR}"/*.whl 2>/dev/null | wc -l)
if [ "${WHEEL_COUNT}" -eq 0 ]; then
    fail "内置依赖目录为空: ${WHEELS_DIR}"
fi

log "发现 ${WHEEL_COUNT} 个内置依赖包，开始离线安装"

# 确保 venv 内有可用的 pip。
# 飞牛的 python3 -m venv 可能不带 pip（Debian 精简版常缺 ensurepip），
# 因此包内必须内置 pip wheel 作为引导。缺失时给出明确指引。
if ! "${VENV_PY}" -m pip --version >/dev/null 2>&1; then
    log "venv 中无 pip，尝试用内置 wheel 引导安装"

    PIP_WHEEL=$(ls -1 "${WHEELS_DIR}"/pip-*.whl 2>/dev/null | head -n 1)
    if [ -z "${PIP_WHEEL}" ]; then
        fail "虚拟环境缺少 pip，且安装包内未内置 pip wheel。请使用完整安装包。"
    fi

    log "使用引导包: $(basename "${PIP_WHEEL}")"
    # 用 wheel 包内的 pip 模块直接安装：python <pip.whl>/pip install pip
    if ! "${VENV_PY}" "${PIP_WHEEL}/pip" install \
            --no-index --find-links "${WHEELS_DIR}" pip >> "${LOG_FILE}" 2>&1; then
        fail "pip 引导安装失败，详见日志: ${LOG_FILE}"
    fi

    if ! "${VENV_PY}" -m pip --version >/dev/null 2>&1; then
        fail "pip 引导后仍不可用，详见日志: ${LOG_FILE}"
    fi
    log "pip 已就绪: $("${VENV_PY}" -m pip --version 2>/dev/null | head -c 40)"
fi

# 核心：--no-index 强制不访问网络，只用本地 wheels。
#
# 注意 sqlalchemy[asyncio] 这类 extras: 在 --no-index 下解析 extras 需要
# 依赖包的元数据，可能因缺少 setuptools 元数据而失败。因此不直接用
# requirements.txt，改为直接安装 wheels 目录内的全部 wheel 包 ——
# 依赖集已由构建脚本完整求解，直接装即可，无需再解析。
log "执行离线安装 (--no-index)"
if ! "${VENV_PY}" -m pip install \
        ${PIP_TARGET_ARGS} \
        --no-index \
        --find-links "${WHEELS_DIR}" \
        --no-cache-dir \
        --no-build-isolation \
        "${WHEELS_DIR}"/*.whl >> "${LOG_FILE}" 2>&1; then
    log "批量安装 wheel 失败，尝试逐个安装以定位问题包"
    INSTALL_FAILED=""
    for w in "${WHEELS_DIR}"/*.whl; do
        [ -f "${w}" ] || continue
        if ! "${VENV_PY}" -m pip install ${PIP_TARGET_ARGS} --no-index --no-cache-dir --no-build-isolation "${w}" >> "${LOG_FILE}" 2>&1; then
            INSTALL_FAILED="${INSTALL_FAILED} $(basename "${w}")"
        fi
    done
    if [ -n "${INSTALL_FAILED}" ]; then
        log "以下包安装失败:${INSTALL_FAILED}"
    fi
fi

# 独立安装源码包依赖（如 pbkdf2，纯 Python 无需编译）
for src_pkg in "${WHEELS_DIR}"/*.tar.gz; do
    [ -f "${src_pkg}" ] || continue
    log "安装源码包: $(basename "${src_pkg}")"
    "${VENV_PY}" -m pip install ${PIP_TARGET_ARGS} --no-index --no-cache-dir --no-build-isolation \
        "${src_pkg}" >> "${LOG_FILE}" 2>&1 || \
        log "警告: $(basename "${src_pkg}") 安装失败"
done

log "依赖安装流程结束"

# 校验核心依赖可导入
MISSING=""
for m in tornado sqlalchemy aiohttp aiosqlite jinja2; do
    if ! "${VENV_PY}" -c "import ${m}" >> "${LOG_FILE}" 2>&1; then
        MISSING="${MISSING} ${m}"
    fi
done

if [ -n "${MISSING}" ]; then
    # 把失败原因和关键日志回显给用户，避免只能看日志文件
    log "缺失的核心依赖:${MISSING}"
    DIAG=$(tail -n 25 "${LOG_FILE}" 2>/dev/null)
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        {
            echo "依赖安装失败，缺少模块:${MISSING}"
            echo ""
            echo "本机 Python: $( ${VENV_PY} --version 2>&1 )"
            echo "内置 wheel 目录: ${WHEELS_DIR}"
            echo ""
            echo "--- 安装日志末尾 ---"
            echo "${DIAG}"
        } > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
fi

log "核心依赖校验通过"

# ---------------------------------------------------------------
# 4. 生成持久化配置
# ---------------------------------------------------------------
# fnOS 的 target 目录在升级时会被替换，因此配置与数据库必须放在
# TRIM_PKGVAR 指向的持久化目录。QD 官方支持 local_config.py 覆盖机制。

LOCAL_CONFIG="${APP_DIR}/local_config.py"

cat > "${LOCAL_CONFIG}" << PYEOF
# -*- coding: utf-8 -*-
# QDX 由 fnOS 生命周期脚本自动生成，请勿手动修改。
# 此文件位于应用源码目录之外不会丢失——升级时由 upgrade_callback 重新生成。

import os

# 数据库持久化到 TRIM_PKGVAR，避免升级时数据丢失
_QDX_DATA = os.environ.get("QDX_DATA_DIR", "${DATA_DIR}")


class sqlite3:
    path = os.path.join(_QDX_DATA, "database.db")


# 是否启用 Redis（fnOS 上默认不启用，Worker 自动降级为本地队列）
redis_url = os.environ.get("REDIS_URL", "redis://localhost:6379")
PYEOF

log "已生成持久化配置: ${LOCAL_CONFIG}"

# 环境变量文件，供 cmd/main 加载
cat > "${ETC_DIR}/env.sh" << ENVEOF
# QDX 运行环境变量 - 由 install_callback 生成
QDX_DATA_DIR="${DATA_DIR}"
QDX_ETC_DIR="${ETC_DIR}"
QDX_PYTHON_MODE="${VENV_MODE}"
ENVEOF

# sitepkg 模式下依赖装在 ${DATA_DIR}/pylibs，运行时需要通过 PYTHONPATH 注入
if [ "${VENV_MODE}" = "sitepkg" ]; then
    echo "PYTHONPATH=\"${DATA_DIR}/pylibs\"" >> "${ETC_DIR}/env.sh"
    log "已配置 PYTHONPATH -> ${DATA_DIR}/pylibs"
fi

log "已生成环境变量文件: ${ETC_DIR}/env.sh"

# ---------------------------------------------------------------
# 5. 导入内置模板
# ---------------------------------------------------------------
if [ -f "${TEMPLATES_DIR}/tpls_history.json" ]; then
    log "发现内置模板快照，导入数据库"
    cd "${APP_DIR}" || fail "无法进入应用目录"
    if QDX_DATA_DIR="${DATA_DIR}" "${VENV_PY}" "${APP_DIR}/deploy/fnos/scripts/import_templates.py" >> "${LOG_FILE}" 2>&1; then
        log "内置模板导入完成"
    else
        # 模板导入失败不应导致整个安装失败
        log "警告: 内置模板导入失败，可在应用内手动导入。详见日志。"
    fi
else
    log "未发现内置模板快照，跳过导入"
fi

log "=== QDX 安装完成 ==="
exit 0
